NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never expose a service_role key with a NEXT_PUBLIC_ prefix.

# New-enquiry email alert (used by /api/notify, called by a Supabase database webhook)
NOTIFY_SECRET=
NOTIFY_TO=
NOTIFY_FROM=
RESEND_API_KEY=

# Optional visit analytics (Plausible-compatible script; leave blank to disable)
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Built-in page-view counter: any long random string (rotates visitor hashes; keep it secret)
ANALYTICS_SALT=
# Google Search Console: the content value of the HTML-tag verification method (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
